# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# META_LLAMA_API_KEY: Optional Meta Llama 3 API key (Groq / Together / Meta Llama endpoints)
# If not provided, LlamaModernize operates with its built-in enterprise AST C# modernization engine.
META_LLAMA_API_KEY="MY_META_LLAMA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
